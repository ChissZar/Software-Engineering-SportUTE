# Reference only: Spring Boot does NOT automatically load this file.
# Set these in STS > Run Configurations > Environment.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=sportute;encrypt=true;trustServerCertificate=true
DB_USERNAME=
DB_PASSWORD=
# Reserved for future JWT/Cloudinary implementation. Never commit real secrets.
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cấu hình gửi mail OTP qua Gmail (hoặc SMTP server)
# Lưu ý: Với Gmail, MAIL_PASSWORD là Mật khẩu ứng dụng 16 ký tự (App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
